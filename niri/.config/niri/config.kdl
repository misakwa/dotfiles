// niri config: https://niri-wm.github.io/niri/Configuration:-Introduction
// Installed by scripts/niri-setup. Check with `niri validate`; niri reloads on save.
//
// Keys follow vim: h/j/k/l move focus, Shift moves the window, Ctrl acts on monitors.
// Mod+Shift+/ lists every bind.

input {
    keyboard {
        xkb {
            layout "us"
            options "caps:ctrl_modifier"
        }
        repeat-delay 300
        repeat-rate 100
    }

    touchpad {
        tap
        dwt
        natural-scroll
        middle-emulation
    }

    // 0% keeps a half-visible column from scrolling into view under the pointer.
    focus-follows-mouse max-scroll-amount="0%"
    warp-mouse-to-focus
}

// No outputs here. niri turns on each monitor at its preferred mode and places
// unconfigured ones left to right. When a monitor is reconnected, niri moves its
// workspaces back to it. Put per-machine `output` blocks in local.kdl (see the end).

layout {
    gaps 6
    center-focused-column "never"
    background-color "#0f0f0f"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#c49ec4"
        inactive-color "#4c4c4c"
    }

    border {
        off
    }

    tab-indicator {
        active-color "#c49ec4"
        inactive-color "#4c4c4c"
    }
}

overview {
    backdrop-color "#0f0f0f"
}

// Keep the swaybg wallpaper visible behind the overview.
layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
}

cursor {
    hide-when-typing
}

environment {
    _JAVA_AWT_WM_NONREPARENTING "1"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+Return hotkey-overlay-title="Open a terminal: kitty" { spawn "kitty"; }
    Mod+Slash hotkey-overlay-title="Run an application: fuzzel" { spawn "fuzzel"; }
    Mod+Shift+Escape hotkey-overlay-title="Lock the screen: swaylock" { spawn-sh "swaylock -f -C ~/.config/niri/swaylock.conf"; }

    Mod+Shift+Q repeat=false { close-window; }
    Mod+O repeat=false { toggle-overview; }

    // At the edge of a column or of the screen, focus continues onto the next
    // workspace or monitor, so h/j/k/l alone reach everything.
    Mod+H     { focus-column-or-monitor-left; }
    Mod+L     { focus-column-or-monitor-right; }
    Mod+J     { focus-window-or-workspace-down; }
    Mod+K     { focus-window-or-workspace-up; }
    Mod+Left  { focus-column-or-monitor-left; }
    Mod+Right { focus-column-or-monitor-right; }
    Mod+Down  { focus-window-or-workspace-down; }
    Mod+Up    { focus-window-or-workspace-up; }

    Mod+Shift+H     { move-column-left-or-to-monitor-left; }
    Mod+Shift+L     { move-column-right-or-to-monitor-right; }
    Mod+Shift+J     { move-window-down-or-to-workspace-down; }
    Mod+Shift+K     { move-window-up-or-to-workspace-up; }
    Mod+Shift+Left  { move-column-left-or-to-monitor-left; }
    Mod+Shift+Right { move-column-right-or-to-monitor-right; }
    Mod+Shift+Down  { move-window-down-or-to-workspace-down; }
    Mod+Shift+Up    { move-window-up-or-to-workspace-up; }

    Mod+Home       { focus-column-first; }
    Mod+End        { focus-column-last; }
    Mod+Shift+Home { move-column-to-first; }
    Mod+Shift+End  { move-column-to-last; }

    Mod+Ctrl+H { focus-monitor-left; }
    Mod+Ctrl+J { focus-monitor-down; }
    Mod+Ctrl+K { focus-monitor-up; }
    Mod+Ctrl+L { focus-monitor-right; }
    Mod+Ctrl+Shift+H { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+J { move-column-to-monitor-down; }
    Mod+Ctrl+Shift+K { move-column-to-monitor-up; }
    Mod+Ctrl+Shift+L { move-column-to-monitor-right; }
    Mod+Alt+H { move-workspace-to-monitor-left; }
    Mod+Alt+J { move-workspace-to-monitor-down; }
    Mod+Alt+K { move-workspace-to-monitor-up; }
    Mod+Alt+L { move-workspace-to-monitor-right; }

    // Workspaces stack vertically. Mod+U and Mod+D go up and down, as Ctrl-U and Ctrl-D do in vim.
    Mod+U             { focus-workspace-up; }
    Mod+D             { focus-workspace-down; }
    Mod+Page_Up       { focus-workspace-up; }
    Mod+Page_Down     { focus-workspace-down; }
    Mod+Shift+U       { move-column-to-workspace-up; }
    Mod+Shift+D       { move-column-to-workspace-down; }
    Mod+Shift+Page_Up   { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+U        { move-workspace-up; }
    Mod+Ctrl+D        { move-workspace-down; }
    Mod+Tab           { focus-workspace-previous; }

    // Workspaces are dynamic. An index past the last one goes to the empty workspace at the bottom.
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma        { consume-window-into-column; }
    Mod+Period       { expel-window-from-column; }
    Mod+W            { toggle-column-tabbed-display; }

    // niri has no binding modes, so these replace sway's resize mode.
    Mod+R            { switch-preset-column-width; }
    Mod+Shift+R      { switch-preset-column-width-back; }
    Mod+Ctrl+R       { switch-preset-window-height; }
    Mod+Ctrl+Shift+R { reset-window-height; }
    Mod+Minus        { set-column-width "-10%"; }
    Mod+Equal        { set-column-width "+10%"; }
    Mod+Shift+Minus  { set-window-height "-10%"; }
    Mod+Shift+Equal  { set-window-height "+10%"; }

    Mod+F       { fullscreen-window; }
    Mod+M       { maximize-column; }
    Mod+Shift+M { maximize-window-to-edges; }
    Mod+E       { expand-column-to-available-width; }
    Mod+Z       { center-column; }
    Mod+Shift+Z { center-visible-columns; }

    Mod+Shift+Space { toggle-window-floating; }
    Mod+Space       { switch-focus-between-floating-and-tiling; }

    Mod+WheelScrollDown cooldown-ms=150       { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150       { focus-workspace-up; }
    Mod+Shift+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Shift+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft  { focus-column-left; }

    Print       { screenshot; }
    Mod+Shift+S { screenshot; }
    Ctrl+Print  { screenshot-screen; }
    Alt+Print   { screenshot-window; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.02+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.02-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioPlay        allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause       allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext        allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev        allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+2%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "2%-"; }

    // An app that inhibits shortcuts (a VM, a remote desktop) cannot take this one.
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    Mod+Shift+E     { quit; }
    Ctrl+Alt+Delete { quit; }
    Mod+Shift+P     { power-off-monitors; }
}

// Per-machine settings, kept out of the repo. Later definitions win, so outputs,
// binds and layout tweaks here override the ones above. Example for a dock whose
// connector names change, matched by make, model and serial (`niri msg outputs`):
//
//   output "Dell Inc. DELL U2720Q ABC123" { mode "3840x2160@60.000"; scale 1.5; position x=0 y=0; }
//   output "eDP-1" { scale 1.25; position x=2560 y=0; }
include optional=true "~/.config/niri/local.kdl"
