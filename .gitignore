tmux/.tmux/plugins
tmux/.tmux/sessions
tmux/.tmux/notify

# Python bytecode (e.g. kitty kitten caches)
__pycache__/
*.pyc

# Pi coding agent: track only the config files; ignore all runtime state
# (sessions, caches, trust, installed extension packages) that folding
# places inside this repo.
pi/.pi/*
!pi/.pi/agent/
pi/.pi/agent/*
!pi/.pi/agent/models.json
!pi/.pi/agent/mcp.json
!pi/.pi/agent/settings.json
!pi/.pi/agent/AGENTS.md

# launchd plists are rendered from *.plist.in (see Makefile) — ignore the output
launchd/Library/LaunchAgents/*.plist

# Emacs Customize writes $DOOMDIR/custom.el; that's machine state, not config
doom/.config/doom/custom.el
