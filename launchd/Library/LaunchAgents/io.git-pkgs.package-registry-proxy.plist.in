<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.git-pkgs.package-registry-proxy</string>
    <!-- @HOME@ is expanded by `make render`; all config lives in the wrapper -->
    <key>ProgramArguments</key>
    <array>
        <string>@HOME@/bin/package-registry-proxy</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
</dict>
</plist>
