#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Attach to the unit's live agent, resume its last session, or start a new one.

An agent already running in a herdr pane answers first: this hands the terminal
to it rather than starting a second agent on the same unit. Leave that terminal
with `ctrl+b q`; the agent keeps running.

With no live agent, runs the agent with the unit root as its working directory,
so it sees every repository in the unit as a subdirectory. Each agent knows its
own history, so this picks the directory and the agent and then gets out of the
way. Use `workctl sessions` to see what history a unit holds.
"""
import argparse
import os
import shutil
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from _workctl import (Unit, add_root_arg, attach_target, derive_units, find_unit,
                      herdr_attach, herdr_running, live_agent, resolve_root,
                      sessions_for, work_dir)

KINDS = ("claude", "codex", "pi")

# Each agent has its own notion of "the most recent one here" and its own
# picker. Delegate to those rather than parsing session files.
LAUNCH = {
    "claude": {"new": [], "continue": ["-c"], "pick": ["-r"]},
    "codex": {"new": [], "continue": ["resume", "--last"], "pick": ["resume"]},
    "pi": {"new": [], "continue": ["-c"], "pick": ["-r"]},
}


def newest_kind(rows, at_root_only=True):
    """The agent whose newest session in this unit is the most recent."""
    usable = [r for r in rows if r["at_root"]] if at_root_only else rows
    if not usable:
        return None
    return min(usable, key=lambda r: r["age"])["kind"]


def outside_twin(name, workspace):
    """A same-named directory beside the work folder, with its own sessions.

    A checkout that predates the unit model can sit at <root>/<name>/<repo>
    with a long history, while <root>/<work>/<name> holds a small leftover.
    Starting in the leftover would silently begin a fresh session.
    """
    path = os.path.join(workspace, name)
    if not os.path.isdir(path) or os.path.realpath(path) == os.path.realpath(workspace):
        return path, []
    return path, sessions_for(Unit(name, path, []), set(KINDS))


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("name", help="unit name, as it appears under the work folder")
    ap.add_argument("--kind", choices=KINDS,
                    help="which agent; default is the one with the newest session here")
    ap.add_argument("--new", action="store_true", help="start a fresh session")
    ap.add_argument("--pick", action="store_true", help="choose from the agent's own picker")
    ap.add_argument("--no-attach", action="store_true",
                    help="start an agent here even when one is live in herdr")
    add_root_arg(ap)
    ap.add_argument("--dry-run", action="store_true", help="print the command and stop")
    args, passthrough = ap.parse_known_args()
    args.root = resolve_root(args.root)

    unit = find_unit(args.name, args.root)
    twin, twin_rows = outside_twin(args.name, args.root)
    if not unit:
        if twin_rows:
            sys.exit(f"no unit named {args.name} under {work_dir(args.root)}, but {twin} "
                     f"holds {len(twin_rows)} session(s). Start the agent there yourself, "
                     f"or bring its checkout in with `workctl adopt`.")
        sys.exit(f"no unit named {args.name} under {work_dir(args.root)}")
    if not os.path.isdir(unit.root):
        sys.exit(f"{unit.name} has no directory at {unit.root}")

    rows = sessions_for(unit, set(KINDS))
    if twin_rows:
        sys.exit(f"{args.name} names two directories, and workctl will not pick one:\n"
                 f"  {unit.root}  ({len(rows)} session(s))\n"
                 f"  {twin}  ({len(twin_rows)} session(s))\n"
                 f"Start the agent in the one you mean, or bring the checkout under "
                 f"{twin} in with `workctl adopt`.")
    # A live agent beats any session file. Resuming beside it would leave two
    # agents on one unit, and only one of them is the one the user left.
    if not args.new and not args.no_attach and herdr_running():
        agent = live_agent(unit.name, derive_units(args.root), args.kind)
        if agent:
            target = attach_target(agent)
            print(f"{unit.name}: attaching to {agent.get('agent') or 'the agent'} "
                  f"({target}, {agent.get('agent_status')}); ctrl+b q to leave",
                  file=sys.stderr)
            if args.dry_run:
                print(f"would run: herdr agent attach {target}", file=sys.stderr)
                return 0
            herdr_attach(target)

    kind = args.kind or newest_kind(rows) or "claude"
    if not shutil.which(kind):
        sys.exit(f"{kind} is not on PATH")

    mode = "new" if args.new else ("pick" if args.pick else "continue")
    at_root = [r for r in rows if r["at_root"] and r["kind"] == kind]
    if mode == "continue" and not at_root:
        # Nothing to continue, so a bare launch is the honest equivalent.
        mode = "new"
        print(f"{unit.name}: no {kind} session at the unit root; starting a new one",
              file=sys.stderr)

    below = [r for r in rows if not r["at_root"]]
    if below and mode != "new":
        print(f"{unit.name}: {len(below)} session(s) sit below the root and stay "
              f"invisible here. Run `workctl sessions {unit.name} --move-to-root`.",
              file=sys.stderr)

    cmd = [kind] + LAUNCH[kind][mode] + passthrough
    print(f"{unit.name}: {' '.join(cmd)}  (in {unit.root})", file=sys.stderr)
    if args.dry_run:
        return 0

    os.chdir(unit.root)
    os.execvp(cmd[0], cmd)


if __name__ == "__main__":
    sys.exit(main())
