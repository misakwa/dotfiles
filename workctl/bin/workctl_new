#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Create a unit of work: one branch and checkout per repository.

Drives worktrunk to create each checkout, so worktrunk's hooks, base-branch
handling, and gates all apply. Overrides the worktree path for each call so the
checkouts land at work/<name>/<repo> rather than under worktrunk's own
template. Then creates a herdr workspace at the unit root, when herdr is
running.

Pass no --repo to create a unit that holds only notes.
"""
import argparse
import json
import os
import subprocess
import sys

WORKSPACE = os.environ.get("WORKCTL_WORKSPACE",
                           os.path.expanduser("~/Projects/vectara-bare"))
BRANCH_PREFIX = os.environ.get("WORKCTL_BRANCH_PREFIX", "misakwa/")

# Worktrunk cannot strip a prefix from a branch name in a path template, so the
# unit name is substituted here and the template supplies only the repo name.
PATH_TEMPLATE = '{{ repo_path }}/../../work/%s/{{ remote_repo }}'


def subdirs(path):
    try:
        return sorted(d for d in os.listdir(path) if os.path.isdir(os.path.join(path, d)))
    except OSError:
        return []


def bare_repos(workspace):
    return [d for d in subdirs(workspace) if os.path.isdir(os.path.join(workspace, d, ".bare"))]


def primary_worktree(workspace, repo):
    for branch in ("main", "master"):
        path = os.path.join(workspace, repo, branch)
        if os.path.isdir(path):
            return path
    return None


def branch_exists(workspace, repo, branch):
    out = subprocess.run(
        ["git", "-C", os.path.join(workspace, repo), "rev-parse", "--verify",
         "--quiet", f"refs/heads/{branch}"],
        capture_output=True, text=True)
    return out.returncode == 0


def herdr_running():
    out = subprocess.run(["herdr", "status", "server"], capture_output=True, text=True)
    return "status: running" in out.stdout


def herdr(args):
    """Run a herdr command and return its parsed result, or None."""
    out = subprocess.run(["herdr"] + args, capture_output=True, text=True)
    if out.returncode != 0:
        print(f"  herdr {' '.join(args)}: {out.stderr.strip()}", file=sys.stderr)
        return None
    try:
        return json.loads(out.stdout).get("result")
    except json.JSONDecodeError:
        return None


def create_checkout(workspace, repo, name, branch, base, dry_run):
    """Create one checkout with worktrunk. Returns its path, or None."""
    cwd = primary_worktree(workspace, repo)
    if not cwd:
        print(f"  {repo}: no primary worktree (expected {repo}/main or {repo}/master)",
              file=sys.stderr)
        return None

    target = os.path.join(workspace, "work", name, repo)
    if os.path.isdir(target):
        print(f"  {repo}: already at {target}")
        return target

    cmd = ["wt", "--config-set", f'worktree-path="{PATH_TEMPLATE % name}"',
           "switch", "--create", branch, "--no-cd", "-y"]
    if base:
        cmd += ["--base", base]

    if dry_run:
        print(f"  {repo}: would run (in {cwd})")
        print(f"    {' '.join(cmd)}")
        return target

    if branch_exists(workspace, repo, branch):
        print(f"  {repo}: branch {branch} already exists; "
              f"run `wt switch {branch}` to attach it", file=sys.stderr)
        return None

    out = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True)
    if out.returncode != 0:
        print(f"  {repo}: {(out.stderr or out.stdout).strip()}", file=sys.stderr)
        return None
    print(f"  {repo}: {target}")
    return target


def attach_herdr(root, name, checkouts, dry_run):
    if dry_run:
        print(f"herdr: would create a workspace at {root}")
        return
    if not herdr_running():
        print("herdr: not running; start it and run `workctl go` to attach this unit")
        return

    result = herdr(["workspace", "create", "--cwd", root, "--label", name, "--focus"])
    if not result:
        return
    workspace_id = (result.get("workspace") or {}).get("workspace_id")
    print(f"herdr: workspace {workspace_id} at {root}")

    # A herdr workspace binds to at most one worktree, so only a single-checkout
    # unit can fill the built-in branch and git_status sidebar rows.
    if workspace_id and len(checkouts) == 1:
        if herdr(["worktree", "open", "--workspace", workspace_id,
                  "--path", checkouts[0], "--no-focus"]):
            print(f"herdr: bound {os.path.basename(checkouts[0])} to the workspace")


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("name", help="unit name; becomes work/<name>/ and the branch suffix")
    ap.add_argument("--repo", action="append", default=[], metavar="REPO",
                    help="repository to include (repeatable); omit for a notes-only unit")
    ap.add_argument("--base", metavar="REF", help="base branch (default: the repo's default)")
    ap.add_argument("--branch", metavar="NAME",
                    help=f"branch name (default: {BRANCH_PREFIX}<name>)")
    ap.add_argument("--workspace", default=WORKSPACE)
    ap.add_argument("--no-herdr", action="store_true", help="do not create a herdr workspace")
    ap.add_argument("--dry-run", action="store_true", help="print what would happen")
    args = ap.parse_args()

    known = bare_repos(args.workspace)
    unknown = [r for r in args.repo if r not in known]
    if unknown:
        sys.exit(f"unknown repository: {', '.join(unknown)}\n"
                 f"available: {', '.join(known)}")

    root = os.path.join(args.workspace, "work", args.name)
    branch = args.branch or f"{BRANCH_PREFIX}{args.name}"

    print(f"{args.name}: {root}")
    if args.repo:
        print(f"branch: {branch}")

    if not args.dry_run:
        os.makedirs(root, exist_ok=True)

    checkouts = []
    for repo in args.repo:
        path = create_checkout(args.workspace, repo, args.name, branch, args.base,
                               args.dry_run)
        if path:
            checkouts.append(path)

    if args.repo and not checkouts:
        sys.exit("no checkout was created")

    if not args.repo:
        print("notes-only unit; no checkout created")

    if not args.no_herdr:
        attach_herdr(root, args.name, checkouts, args.dry_run)

    print(f"\ncd {root}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
