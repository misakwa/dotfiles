#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""List the agent sessions recorded inside your units.

Each agent files its history under the directory it ran in. Start Claude at a
unit root and it shows only the sessions recorded for that exact path, so work
done one level down, inside a checkout, is invisible. This finds those sessions
and can move them up to the unit root. Use `workctl agent` to resume one.
"""
import argparse
import json
import os
import shutil
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from _workctl import (CLAUDE_ROOT, CODEX_ROOT, DEPTH, PI_ROOT, add_root_arg,
                      candidates, derive_units, find_unit, sessions_for, slug)


def move_to_root(unit, rows, apply_):
    """Refile a session under the unit root so Claude started there sees it."""
    moved = 0
    for row in rows:
        if row["at_root"]:
            continue
        if row["kind"] == "claude":
            dest_dir = os.path.join(CLAUDE_ROOT, slug(unit.root))
        elif row["kind"] == "pi":
            dest_dir = os.path.join(PI_ROOT, f"-{slug(unit.root)}-")
        else:
            print(f"  skip  {row['kind']} files by date, not by directory: "
                  f"{os.path.basename(row['file'])}")
            continue

        dest = os.path.join(dest_dir, os.path.basename(row["file"]))
        if os.path.exists(dest):
            print(f"  skip  already at the root: {os.path.basename(row['file'])}")
            continue
        rel = os.path.relpath(row["cwd"], unit.root)
        if not apply_:
            print(f"  would move  {row['kind']:<7} {rel} -> {dest}")
            moved += 1
            continue
        os.makedirs(dest_dir, exist_ok=True)
        shutil.move(row["file"], dest)
        print(f"  moved  {row['kind']:<7} {rel} -> {dest}")
        moved += 1
    return moved


def orphans(workspace, kinds):
    """Sessions filed against a unit directory that no longer exists.

    Settling a unit removes its checkouts and its directory. The agent history
    stays behind, and nothing else will ever mention it again.
    """
    work = os.path.join(workspace, "work")
    marker = slug(work) + "-"
    found = []
    if "claude" in kinds and os.path.isdir(CLAUDE_ROOT):
        for entry in sorted(os.listdir(CLAUDE_ROOT)):
            if not entry.startswith(marker):
                continue
            path = os.path.join(work, entry[len(marker):].replace("-", os.sep))
            directory = os.path.join(CLAUDE_ROOT, entry)
            names = [n for n in os.listdir(directory) if n.endswith(".jsonl")]
            if names and not os.path.isdir(_first_existing(work, entry[len(marker):])):
                found.append(("claude", entry[len(marker):], directory, len(names)))
    return found


def _first_existing(work, tail):
    """A unit name may hold a hyphen, so a flattened slug is ambiguous.

    Try the whole tail as one directory name first, then progressively treat
    hyphens as separators. Return the first that exists, else the plain form.
    """
    candidate = os.path.join(work, tail)
    if os.path.isdir(candidate):
        return candidate
    parts = tail.split("-")
    for cut in range(len(parts) - 1, 0, -1):
        candidate = os.path.join(work, "-".join(parts[:cut]), *parts[cut:])
        if os.path.isdir(candidate):
            return candidate
    return os.path.join(work, tail)


def render(unit_name, rows, root):
    print(unit_name)
    for row in rows:
        rel = os.path.relpath(row["cwd"], os.path.join(root, "work"))
        mark = "" if row["at_root"] else "  below root"
        print(f"  {row['kind']:<7} {rel:<58} {row['age']:>4}d  "
              f"{row['size'] // 1024:>6}K{mark}")


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("name", nargs="?", help="unit name; omit to scan every unit")
    add_root_arg(ap)
    ap.add_argument("--kind", action="append", choices=["claude", "codex", "pi"],
                    default=[], help="limit to one agent (repeatable)")
    ap.add_argument("--depth", type=int, default=DEPTH,
                    help=f"directory levels to scan below the unit root (default {DEPTH})")
    ap.add_argument("--below-root", action="store_true",
                    help="show only the sessions a run at the unit root would miss")
    ap.add_argument("--move-to-root", action="store_true",
                    help="refile those sessions under the unit root")
    ap.add_argument("--apply", action="store_true", help="perform the move")
    ap.add_argument("--orphans", action="store_true",
                    help="show sessions whose unit directory is gone")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()

    kinds = set(args.kind) or {"claude", "codex", "pi"}

    if args.orphans:
        rows = orphans(args.root, kinds)
        if args.json:
            json.dump([{"kind": k, "unit": n, "dir": d, "sessions": c}
                       for k, n, d, c in rows], sys.stdout, indent=1)
            return 0
        if not rows:
            print("no orphaned sessions")
            return 0
        for kind, name, directory, count in rows:
            print(f"  {kind:<7} {name:<44} {count:>3} sessions  {directory}")
        print(f"\n{len(rows)} units are gone but their history remains")
        return 0

    if args.name:
        unit = find_unit(args.name, args.root)
        if not unit:
            sys.exit(f"no unit named {args.name} under {args.root}/work")
        units = [unit]
    elif args.move_to_root:
        sys.exit("--move-to-root needs a unit name; refusing to refile every unit at once")
    else:
        units = derive_units(args.root)

    found = {u.name: sessions_for(u, kinds, args.depth) for u in units}
    if args.below_root:
        found = {n: [r for r in rows if not r["at_root"]] for n, rows in found.items()}

    if args.json:
        json.dump([r for rows in found.values() for r in rows], sys.stdout, indent=1)
        return 0

    if args.move_to_root:
        unit = units[0]
        rows = found[unit.name]
        print(f"{unit.name}: {'APPLY' if args.apply else 'DRY RUN, pass --apply to move'}")
        moved = move_to_root(unit, rows, args.apply)
        if not moved:
            print("  nothing to move")
        elif not args.apply:
            print(f"\n{moved} sessions would move")
        else:
            # The records keep the directory they were written in. That is
            # history, not a pointer, so Claude still lists the moved session.
            print(f"\n{moved} sessions moved. Their records still name the old "
                  f"directory; that is historical and does not affect resuming.")
        return 0

    total = sum(len(rows) for rows in found.values())
    if not total:
        print("no sessions found")
        return 0
    for name in sorted(n for n, rows in found.items() if rows):
        render(name, found[name], args.root)
    below = sum(1 for rows in found.values() for r in rows if not r["at_root"])
    print(f"\n{total} sessions across {sum(1 for r in found.values() if r)} units; "
          f"{below} below a unit root")
    return 0


if __name__ == "__main__":
    sys.exit(main())
