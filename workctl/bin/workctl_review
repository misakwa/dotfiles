#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Review one unit as a single diff, across every repository it touches.

Untracked files appear in the branch and working diffs as new files. `git diff`
alone never lists them, and a settle-time review has to see them.
"""
import argparse
import os
import subprocess
import sys
import tempfile

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from _workctl import add_root_arg, find_unit, resolve_root, run, work_dir


def merge_base(checkout):
    head = run(["git", "-C", checkout, "symbolic-ref", "--short",
                "refs/remotes/origin/HEAD"]).strip() or "origin/master"
    return run(["git", "-C", checkout, "merge-base", head, "HEAD"]).strip() or None


def diff_args(checkout, mode):
    if mode == "staged":
        return ["diff", "--staged"]
    if mode == "working":
        return ["diff"]
    base = merge_base(checkout)
    return ["diff", base] if base else None


def untracked_files(checkout):
    return run(["git", "-C", checkout, "ls-files", "--others", "--exclude-standard"]).splitlines()


def untracked_diff(checkout, prefixes):
    """One new-file diff per untracked file, in the same format as the rest."""
    text = ""
    for path in untracked_files(checkout):
        # --no-index exits 1 whenever the two sides differ, which is always.
        text += run(["git", "-C", checkout, "diff", "--no-index"] + prefixes
                    + ["--", os.devnull, path], allow_failure=True)
    return text


def build_patch(unit, mode, handle):
    """Write one patch covering every checkout. Returns the file count."""
    files = 0
    for checkout in unit.checkouts:
        args = diff_args(checkout, mode)
        if args is None:
            continue
        label = unit.label_for(checkout)
        prefixes = [f"--src-prefix=a/{label}/", f"--dst-prefix=b/{label}/"]
        text = run(["git", "-C", checkout] + args + prefixes)
        if mode != "staged":
            text += untracked_diff(checkout, prefixes)
        handle.write(text)
        files += sum(1 for line in text.splitlines() if line.startswith("diff --git "))
    handle.flush()
    return files


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("name", help="unit name, as it appears under work/")
    add_root_arg(ap)
    mode = ap.add_mutually_exclusive_group()
    mode.add_argument("--branch", dest="mode", action="store_const", const="branch",
                      help="changes since the merge base, committed and uncommitted (default)")
    mode.add_argument("--staged", dest="mode", action="store_const", const="staged",
                      help="staged changes only")
    mode.add_argument("--working", dest="mode", action="store_const", const="working",
                      help="uncommitted changes only, untracked files included")
    ap.set_defaults(mode="branch")
    args, passthrough = ap.parse_known_args()
    args.root = resolve_root(args.root)

    unit = find_unit(args.name, args.root)
    if not unit:
        sys.exit(f"no unit named {args.name} under {work_dir(args.root)}")
    if not unit.checkouts:
        sys.exit(f"{args.name} holds only notes; there is nothing to diff")

    with tempfile.NamedTemporaryFile("w", suffix=".patch", prefix="workctl-review.",
                                     delete=False, encoding="utf-8") as handle:
        patch = handle.name
        files = build_patch(unit, args.mode, handle)
    try:
        if not files:
            print(f"{unit.name}: no changes in {args.mode} mode", file=sys.stderr)
            return 0
        print(f"{unit.name}: {files} files across {len(unit.checkouts)} checkouts "
              f"({args.mode})", file=sys.stderr)
        return subprocess.run(["hunk", "patch", patch] + passthrough).returncode
    finally:
        os.unlink(patch)


if __name__ == "__main__":
    sys.exit(main())
