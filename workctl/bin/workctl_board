#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Rank every unit of work by how much it needs you."""
import argparse
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from _workctl import (WORKSPACE, IGNORED_CHECKS, agents_by_unit, bare_repos,
                      derive_units, failing_checks, git_facts, is_dirty, pr_facts)

BUCKETS = ["BLOCKED", "READY", "MERGEABLE", "BROKEN", "WAITING", "ACTIVE",
           "SETTLE", "COLD", "NOTES", "UNKNOWN"]


def inspect(unit, git, prs, agents):
    trees = [git[p] for p in (os.path.realpath(c) for c in unit.checkouts) if p in git]

    found, dirty, ahead, integrated = [], False, 0, 0
    for repo, item in trees:
        pr = prs.get((repo, item.get("branch")))
        if pr:
            found.append((repo, pr))
        dirty = dirty or is_dirty(item)
        ahead = max(ahead, (item.get("default_branch") or {}).get("ahead") or 0)
        integrated += item["display"]["state"] == "integrated"

    live = agents.get(unit.name, [])
    return dict(name=unit.name, root=unit.root, age=unit.age_days, prs=found,
                failures=[], dirty=dirty, ahead=ahead, integrated=integrated,
                n_checkouts=len(unit.checkouts), n_known=len(trees),
                stray=len(unit.checkouts) - len(trees),
                agents=[{"name": a.get("name"), "kind": a.get("agent"),
                         "status": a.get("agent_status"),
                         "pane": a.get("pane_id")} for a in live])


def bucket(unit):
    states = {a["status"] for a in unit["agents"]}
    if "blocked" in states:
        return "BLOCKED"
    if "done" in states:
        return "READY"
    if unit["prs"]:
        if unit["failures"]:
            return "BROKEN"
        if any(pr.get("reviewDecision") == "APPROVED" for _, pr in unit["prs"]):
            return "MERGEABLE"
        return "WAITING"
    if unit["n_checkouts"] == 0:
        return "NOTES"
    if unit["n_known"] == 0:
        return "UNKNOWN"
    if unit["integrated"] == unit["n_known"]:
        return "SETTLE"
    # Recency alone, not evidence of work. A unit created today has no commits
    # and no changes yet, and calling that cold is wrong.
    if unit["age"] <= 30 or "working" in states:
        return "ACTIVE"
    return "COLD"


def render(unit):
    prs = " ".join(
        f"{repo}#{pr['number']}"
        f"/{'draft' if pr['isDraft'] else (pr.get('reviewDecision') or 'pending').lower()}"
        for repo, pr in unit["prs"])
    bits = [prs] if prs else []
    if unit["failures"]:
        bits.append("FAIL=" + ",".join(unit["failures"]))
    # A checkout from a repository outside the workspace: the unit's state is
    # only partly known, so say so rather than rank it as if it were complete.
    if unit["stray"]:
        bits.append(f"?{unit['stray']}/{unit['n_checkouts']} outside workspace")
    for agent in unit["agents"]:
        bits.append(f"[{agent['kind'] or 'agent'}:{agent['status']}]")
    return f"  {unit['age']:>4}d  {unit['name']:<52} {' '.join(bits)}".rstrip()


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("workspace", nargs="?", default=WORKSPACE)
    ap.add_argument("--bucket", action="append", help="show only these buckets")
    ap.add_argument("--ignore-check", action="append", default=[],
                    help="check name to treat as noise (repeatable)")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--refresh", action="store_true",
                    help="ignore the cache and re-read worktrunk and GitHub")
    args = ap.parse_args()

    if not os.path.isdir(os.path.join(args.workspace, "work")):
        sys.exit(f"no work/ directory under {args.workspace}")

    repos = bare_repos(args.workspace)
    units = derive_units(args.workspace)
    git = git_facts(args.workspace, repos, refresh=args.refresh)
    prs = pr_facts(repos, workspace=args.workspace, refresh=args.refresh)
    agents = agents_by_unit(units)

    rows = [inspect(u, git, prs, agents) for u in units]
    matched = {(repo, pr["number"]) for r in rows for repo, pr in r["prs"]}
    checks = failing_checks(matched, ignored=IGNORED_CHECKS | set(args.ignore_check))
    for row in rows:
        row["failures"] = sorted({n for repo, pr in row["prs"]
                                  for n in checks.get((repo, pr["number"]), [])})
        row["bucket"] = bucket(row)

    if args.json:
        json.dump(rows, sys.stdout, indent=1)
        return 0

    wanted = [b.upper() for b in args.bucket] if args.bucket else BUCKETS
    print(f"{len(rows)} units in {args.workspace}\n")
    for name in BUCKETS:
        group = sorted((r for r in rows if r["bucket"] == name), key=lambda r: r["age"])
        if name not in wanted or not group:
            continue
        print(f"== {name} ({len(group)})")
        for row in group:
            print(render(row))
        print()
    return 0


if __name__ == "__main__":
    sys.exit(main())
