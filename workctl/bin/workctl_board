#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Rank every unit of work by how much it needs you."""
import argparse
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from _workctl import (IGNORED_CHECKS, add_repo_scope_arg, add_root_arg,
                      agents_by_unit, attach_target, derive_units,
                      failing_checks, find_unit, git_facts, is_dirty,
                      is_own_pr, outside_units, pr_author,
                      pr_facts, resolve_root, scan_repos, unresolved_threads,
                      work_dir)

BUCKETS = ["BLOCKED", "READY", "MERGEABLE", "BROKEN", "REVIEW", "WAITING",
           "ACTIVE", "SETTLE", "COLD", "NOTES", "UNKNOWN"]

# Checkouts on disk that no unit holds. Not a bucket: the board cannot rank a
# checkout it cannot attribute, so they print after the buckets instead.
OUTSIDE = "OUTSIDE"


def hidden_below(unit, held):
    """Checkouts under the unit that no unit at all holds.

    `hidden_checkouts` compares against the unit's own checkouts only, so a
    parent would count its sub-units' checkouts, and those are on the board.
    """
    return [p for p in unit.hidden_checkouts() if os.path.realpath(p) not in held]


def inspect(unit, git, prs, agents, held):
    trees = [git[p] for p in (os.path.realpath(c) for c in unit.checkouts) if p in git]

    found, dirty, ahead, integrated = [], False, 0, 0
    for repo, item in trees:
        pr = prs.get((repo, item.get("branch")))
        if pr:
            found.append((repo, pr))
        dirty = dirty or is_dirty(item)
        ahead = max(ahead, (item.get("default_branch") or {}).get("ahead") or 0)
        integrated += item["display"]["state"] == "integrated"

    live = agents.get(unit.name, [])
    return dict(name=unit.name, root=unit.root, age=unit.age_days, prs=found,
                failures=[], dirty=dirty, ahead=ahead, integrated=integrated,
                n_checkouts=len(unit.checkouts), n_known=len(trees),
                stray=len(unit.checkouts) - len(trees),
                hidden=len(hidden_below(unit, held)), threads=0,
                agents=[{"name": a.get("name"), "kind": a.get("agent"),
                         "status": a.get("agent_status"),
                         "pane": a.get("pane_id"),
                         "handle": attach_target(a)} for a in live])


def inspect_outside(repo, path, item, prs, root):
    """A row for a checkout no unit holds, in the shape of a unit row.

    `workctl done` and `workctl sweep` read the same JSON list and look rows
    up by name and bucket, so the shape has to match theirs.
    """
    pr = prs.get((repo, item.get("branch")))
    return dict(name=os.path.relpath(path, root), root=path, age=None,
                prs=[(repo, pr)] if pr else [], failures=[], dirty=is_dirty(item),
                ahead=(item.get("default_branch") or {}).get("ahead") or 0,
                integrated=int(item["display"]["state"] == "integrated"),
                n_checkouts=1, n_known=1, stray=0, hidden=0, threads=0, agents=[],
                repo=repo, branch=item.get("branch"),
                state=item["display"]["state"], bucket=OUTSIDE)


# Buckets that exist because an agent wants a person. The board is where you
# find them, so it says how to reach one.
ATTACHABLE = ("BLOCKED", "READY")


def bucket(unit):
    states = {a["status"] for a in unit["agents"]}
    if "blocked" in states:
        return "BLOCKED"
    if "done" in states:
        return "READY"
    if unit["prs"]:
        if not any(is_own_pr(pr) for _, pr in unit["prs"]):
            return "REVIEW"
        if unit["failures"]:
            return "BROKEN"
        if any(pr.get("reviewDecision") == "APPROVED" for _, pr in unit["prs"]):
            return "MERGEABLE"
        return "WAITING"
    if unit["n_checkouts"] == 0 and not unit["hidden"]:
        return "NOTES"
    if unit["n_known"] == 0:
        return "UNKNOWN"
    if unit["integrated"] == unit["n_known"]:
        return "SETTLE"
    # Recency alone, not evidence of work. A unit created today has no commits
    # and no changes yet, and calling that cold is wrong.
    if unit["age"] <= 30 or "working" in states:
        return "ACTIVE"
    return "COLD"


def render_pr(repo, pr):
    state = "draft" if pr["isDraft"] else (pr.get("reviewDecision") or "pending").lower()
    text = f"{repo}#{pr['number']}/{state}"
    return text if is_own_pr(pr) else f"{text} by {pr_author(pr)}"


def render(unit):
    bits = [render_pr(repo, pr) for repo, pr in unit["prs"]]
    if unit["failures"]:
        bits.append("FAIL=" + ",".join(unit["failures"]))
    # A checkout from a repository the board did not scan: the unit's state is
    # only partly known, so say so rather than rank it as if it were complete.
    if unit["stray"]:
        bits.append(f"?{unit['stray']}/{unit['n_checkouts']} repos not scanned")
    if unit["hidden"]:
        bits.append(f"+{unit['hidden']} checkouts deeper than the unit")
    if unit["threads"]:
        bits.append(f"{unit['threads']} unanswered")
    for agent in unit["agents"]:
        # The handle, not just the state: it is what `herdr agent attach` takes
        # for an agent herdr never named, where the pane is the only address.
        bits.append(f"[{agent['handle']} {agent['kind'] or 'agent'}:{agent['status']}]")
    return f"  {unit['age']:>4}d  {unit['name']:<52} {' '.join(bits)}".rstrip()


def outside_group(row, repos, work):
    top = row["name"].split(os.sep)[0]
    if top == work:
        return f"deeper than any unit under {work}/"
    if top in repos:
        return "inside a repository, on no unit"
    return f"outside {work}/"


def ordered(rows):
    """A bucket's rows, youngest first, with each parent's sub-units together.

    Ranking a sub-unit by its own age alone scatters `INC-355/a` and
    `INC-355/b` to opposite ends of the bucket, and they are one piece of work.
    """
    youngest = {}
    for row in rows:
        top = row["name"].split("/")[0]
        youngest[top] = min(youngest.get(top, row["age"]), row["age"])
    return sorted(rows, key=lambda r: (youngest[r["name"].split("/")[0]],
                                       r["name"].split("/")[0], r["name"]))


def render_outside(row):
    bits = [render_pr(repo, pr) for repo, pr in row["prs"]] + [row["state"]]
    if row["dirty"]:
        bits.append("dirty")
    return f"     -   {row['name']:<52} {' '.join(bits)}".rstrip()


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    # `workctl done` and `workctl sweep` still pass the root as the positional.
    ap.add_argument("dir", nargs="?", metavar="DIR",
                    help="the same as --root; a unit name is a mistake here")
    add_root_arg(ap)
    add_repo_scope_arg(ap)
    ap.add_argument("--bucket", action="append", type=str.upper,
                    choices=BUCKETS + [OUTSIDE], metavar="NAME",
                    help="show only these sections (repeatable): "
                         + ", ".join(BUCKETS + [OUTSIDE]))
    ap.add_argument("--ignore-check", action="append", default=[],
                    help="check name to treat as noise (repeatable)")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--refresh", action="store_true",
                    help="ignore the cache and re-read worktrunk and GitHub")
    args = ap.parse_args()
    args.root = resolve_root(args.root)

    if args.dir and not os.path.isdir(work_dir(args.dir)):
        if find_unit(args.dir, args.root):
            sys.exit(f"{args.dir} is a unit, not a root. "
                     f"For one unit run: workctl show {args.dir}")
        sys.exit(f"no work folder at {work_dir(args.dir)}")
    if args.dir:
        args.root = resolve_root(args.dir)
    work = work_dir(args.root)
    if not os.path.isdir(work):
        sys.exit(f"no work folder at {work}")

    repos = scan_repos(args.root, args.all_repos)
    units = derive_units(args.root)
    git = git_facts(args.root, repos, refresh=args.refresh)
    prs = pr_facts(repos, workspace=args.root, refresh=args.refresh)
    agents = agents_by_unit(units)

    held = {os.path.realpath(c) for u in units for c in u.checkouts}
    rows = [inspect(u, git, prs, agents, held) for u in units]
    outside = [inspect_outside(repo, path, item, prs, args.root)
               for repo, path, item in outside_units(git, args.root)]
    matched = {(repo, pr["number"]) for r in rows for repo, pr in r["prs"]}
    checks = failing_checks(matched, ignored=IGNORED_CHECKS | set(args.ignore_check),
                            root=args.root)
    for row in rows:
        row["failures"] = sorted({n for repo, pr in row["prs"]
                                  for n in checks.get((repo, pr["number"]), [])})
        row["bucket"] = bucket(row)

    # Only the approved ones. An unanswered question matters most where the
    # board is about to tell you to merge, and each lookup costs a request.
    ready = [(repo, pr["number"]) for r in rows if r["bucket"] == "MERGEABLE"
             for repo, pr in r["prs"]]
    threads = unresolved_threads(ready, root=args.root) if ready else {}
    for row in rows:
        row["threads"] = sum(threads.get((repo, pr["number"]), 0)
                             for repo, pr in row["prs"])

    if args.json:
        json.dump(rows + outside, sys.stdout, indent=1)
        return 0

    wanted = args.bucket or BUCKETS + [OUTSIDE]
    print(f"{len(rows)} units in {args.root}\n")
    for name in BUCKETS:
        group = ordered([r for r in rows if r["bucket"] == name])
        if name not in wanted or not group:
            continue
        hint = "  attach with: workctl agent <unit>" if name in ATTACHABLE else ""
        print(f"== {name} ({len(group)}){hint}")
        for row in group:
            print(render(row))
        print()

    if OUTSIDE in wanted and outside:
        folder = os.path.basename(work)
        print(f"== {OUTSIDE} ({len(outside)})  checkouts that no unit holds; "
              "the board cannot rank them")
        for group in dict.fromkeys(outside_group(r, repos, folder) for r in outside):
            print(f"  {group}")
            for row in outside:
                if outside_group(row, repos, folder) == group:
                    print(render_outside(row))
        print()
    return 0


if __name__ == "__main__":
    sys.exit(main())
