#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Print one unit in full: its checkouts, pull requests, agents, and notes."""
import argparse
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from _workctl import (IGNORED_CHECKS, add_root_arg, agents_by_unit, derive_units,
                      failing_checks, find_unit, git_facts, is_checkout, is_dirty,
                      pr_author, pr_facts, resolve_root, run, work_dir)


def human_size(size):
    for suffix in ("B", "K", "M", "G"):
        if size < 1024 or suffix == "G":
            return f"{size:.0f}{suffix}"
        size /= 1024


def note_files(root):
    """Every unversioned file at the unit root. Directories are not notes.

    When the root is itself a checkout, the repository's own tracked files sit
    there too, and README.md is not a note.
    """
    try:
        entries = sorted(os.scandir(root), key=lambda entry: entry.name)
    except OSError:
        return []
    tracked = set()
    if is_checkout(root):
        tracked = set(run(["git", "-C", root, "ls-files"]).splitlines())
    notes = []
    for entry in entries:
        if entry.name == ".git" or entry.is_dir() or entry.name in tracked:
            continue
        try:
            size = entry.stat().st_size
        except OSError:
            size = 0
        notes.append({"name": entry.name, "size": size})
    return notes


def sub_units_of(unit, units):
    """The sub-units a parent name stands for, empty when the unit is its own.

    A directory holding only sub-units is not a unit, yet `find_unit` accepts
    its name, so the report has to say which parts it gathered.
    """
    if unit.name in {u.name for u in units}:
        return []
    return [u.name for u in units if u.name.startswith(unit.name + "/")]


def agents_of(unit, units, subs):
    """The unit's agents, plus its sub-units' when the name stands for them.

    `find_unit` gathers the checkouts of every sub-unit under a parent name, so
    the agents follow the same rule and the two halves of the report agree.
    """
    found = agents_by_unit(units)
    return [agent for name in [unit.name] + subs for agent in found.get(name, [])]


def git_probe(checkout):
    """The same facts read straight from git, for a checkout worktrunk misses.

    A unit may hold a checkout of a repository that lives outside the root,
    and `wt list` only ever reports the repositories inside it.
    """
    origin = run(["git", "-C", checkout, "config", "--get", "remote.origin.url"]).strip()
    repo = os.path.basename(origin).removesuffix(".git") or None
    branch = run(["git", "-C", checkout, "rev-parse", "--abbrev-ref", "HEAD"]).strip()
    if branch in ("", "HEAD"):
        branch = None

    base = run(["git", "-C", checkout, "symbolic-ref", "--short",
                "refs/remotes/origin/HEAD"]).strip()
    ahead = behind = None
    if base and branch:
        counts = run(["git", "-C", checkout, "rev-list", "--left-right", "--count",
                      f"{base}...HEAD"]).split()
        if len(counts) == 2:
            behind, ahead = int(counts[0]), int(counts[1])

    dirty = bool(run(["git", "-C", checkout, "status", "--porcelain"]).strip())
    return dict(repo=repo, branch=branch, dirty=dirty, ahead=ahead, behind=behind,
                state=None, source="git")


def inspect_checkout(unit, checkout, git):
    row = dict(path=checkout, label=unit.label_for(checkout), repo=None,
               branch=None, dirty=None, ahead=None, behind=None, state=None,
               source=None, pr=None, failures=[])
    repo, item = git.get(os.path.realpath(checkout), (None, None))
    if item is None:
        row.update(git_probe(checkout))
        return row
    default = item.get("default_branch") or {}
    row.update(repo=repo, branch=item.get("branch"), dirty=is_dirty(item),
               ahead=default.get("ahead"), behind=default.get("behind"),
               state=(item.get("display") or {}).get("state"), source="worktrunk")
    return row


def collect(unit, units, workspace, ignore, refresh=False):
    git = git_facts(workspace, refresh=refresh)
    rows = [inspect_checkout(unit, c, git) for c in unit.checkouts]

    repos = sorted({row["repo"] for row in rows if row["repo"]})
    prs = pr_facts(repos, workspace=workspace, refresh=refresh) if repos else {}
    for row in rows:
        row["pr"] = prs.get((row["repo"], row["branch"]))

    pairs = {(row["repo"], row["pr"]["number"]) for row in rows if row["pr"]}
    checks = failing_checks(pairs, ignored=IGNORED_CHECKS | set(ignore),
                            root=workspace)
    for row in rows:
        if row["pr"]:
            row["failures"] = checks.get((row["repo"], row["pr"]["number"]), [])

    # `hidden_checkouts` compares against this unit alone, so a parent would
    # list its sub-units' checkouts; those are units of their own.
    held = {os.path.realpath(c) for u in units for c in u.checkouts}
    hidden = [os.path.relpath(p, unit.root) for p in unit.hidden_checkouts()
              if os.path.realpath(p) not in held]
    subs = sub_units_of(unit, units)
    return dict(name=unit.name, root=unit.root, age=unit.age_days, sub_units=subs,
                checkouts=rows, notes=note_files(unit.root), hidden=hidden,
                agents=[dict(name=a.get("name"), kind=a.get("agent"),
                             status=a.get("agent_status"), pane=a.get("pane_id"),
                             cwd=a.get("foreground_cwd") or a.get("cwd"))
                        for a in agents_of(unit, units, subs)])


def render_checkout(row):
    print(f"  {row['label']}  ({row['repo'] or 'unknown repository'})")
    facts = [row["branch"] or "detached HEAD", "dirty" if row["dirty"] else "clean"]
    if row["ahead"] is not None:
        facts.append(f"ahead {row['ahead']}")
    if row["behind"] is not None:
        facts.append(f"behind {row['behind']}")
    if row["state"]:
        facts.append(row["state"])
    print("    " + "  ".join(facts))

    pr = row["pr"]
    if not pr:
        print("    no open pull request")
        return
    review = "draft" if pr.get("isDraft") else (pr.get("reviewDecision") or "pending").lower()
    author = pr_author(pr)
    print(f"    {row['repo']}#{pr['number']}  {review}  "
          f"{'by ' + author + '  ' if author else ''}{pr.get('url', '')}".rstrip())
    if row["failures"]:
        print(f"    checks fail: {', '.join(row['failures'])}")
    else:
        print("    no failing check")


def render(report):
    print(report["name"])
    if report["sub_units"]:
        count = len(report["sub_units"])
        print(f"  parent of {count} sub-unit{'' if count == 1 else 's'}; "
              f"the checkouts below are theirs:")
        for name in report["sub_units"]:
            print(f"    {name}")
        print("  `workctl done` takes a sub-unit name, not the parent")
    print(f"  {report['root']}")
    print(f"  {report['age']} days since the newest change")

    print(f"\ncheckouts ({len(report['checkouts'])})")
    for row in report["checkouts"]:
        render_checkout(row)
    if not report["checkouts"] and not report["hidden"]:
        print("  none; this unit holds only notes")
    if report["hidden"]:
        print(f"\ncheckouts deeper than the unit ({len(report['hidden'])}); "
              "workctl does not track these")
        for path in report["hidden"]:
            print(f"  {path}")

    print(f"\nagents ({len(report['agents'])})")
    for agent in report["agents"]:
        label = agent["name"] or agent["kind"] or "agent"
        print(f"  {label}  {agent['status']}  {agent['cwd'] or ''}".rstrip())

    print(f"\nnotes ({len(report['notes'])})")
    for note in report["notes"]:
        print(f"  {note['name']}  {human_size(note['size'])}")


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("name", help="unit name, as it appears under the work folder")
    add_root_arg(ap)
    ap.add_argument("--ignore-check", action="append", default=[],
                    help="check name to treat as noise (repeatable)")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--refresh", action="store_true",
                    help="ignore the cache and re-read worktrunk and GitHub")
    args = ap.parse_args()
    args.root = resolve_root(args.root)

    units = derive_units(args.root)
    unit = find_unit(args.name, args.root)
    if not unit:
        sys.exit(f"no unit named {args.name} under {work_dir(args.root)}")

    report = collect(unit, units, args.root, args.ignore_check, refresh=args.refresh)
    if args.json:
        json.dump(report, sys.stdout, indent=1)
        print()
        return 0
    render(report)
    return 0


if __name__ == "__main__":
    sys.exit(main())
