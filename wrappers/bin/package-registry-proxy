#!/bin/sh
# Named launcher for the git-pkgs package-registry proxy: keeps every path
# $HOME-relative so the LaunchAgent carries no hardcoded home directory, and
# gives launchd / Login Items a descriptive name instead of the bare "proxy".
: "${HOME:?HOME is not set}"
PATH="/opt/homebrew/bin:/usr/local/bin:/home/linuxbrew/.linuxbrew/bin:$HOME/.local/bin:$PATH"; export PATH
cache="$HOME/.cache/git-pkgs"
mkdir -p "$cache/artifacts"
export PROXY_LISTEN=":8377"
export PROXY_BASE_URL="http://localhost:8377"
export PROXY_STORAGE_URL="file://$cache/artifacts"
export PROXY_DATABASE_DRIVER="sqlite"
export PROXY_DATABASE_PATH="$cache/proxy.db"
exec >>"$cache/proxy.log" 2>>"$cache/proxy.error.log"
exec proxy
