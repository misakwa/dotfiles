#!/bin/sh
# Named launcher for llama-swap under launchd: keeps paths $HOME-relative and
# avoids shadowing the real `llama-swap` binary on PATH.
: "${HOME:?HOME is not set}"
PATH="/opt/homebrew/bin:/usr/local/bin:/home/linuxbrew/.linuxbrew/bin:$HOME/.local/bin:$PATH"; export PATH
logs="$HOME/.cache/llama-swap"
mkdir -p "$logs"
exec >>"$logs/out.log" 2>>"$logs/err.log"
exec llama-swap --config "$HOME/.config/llama-swap/config.yaml" --listen 127.0.0.1:8080
